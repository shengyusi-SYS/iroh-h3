 /// A trait describing the "send" actions of a QUIC stream.
 pub trait SendStream<B: Buf> {
+    /// Observe peer STOP_SENDING or connection failure without writing data.
+    ///
+    /// `Ok(Some(code))` means peer cancellation; `Ok(None)` means acknowledged
+    /// completion. Only poll before completion. The default has no notification;
+    /// adapters supporting independent cancellation must override it.
+    fn poll_stopped(
+        &mut self,
+        _cx: &mut task::Context<'_>,
+    ) -> Poll<Result<Option<u64>, StreamErrorIncoming>> {
+        Poll::Pending
+    }
+
     /// Polls if the stream can send more data.
     fn poll_ready(&mut self, cx: &mut task::Context<'_>) -> Poll<Result<(), StreamErrorIncoming>>;
 
